---
import { SITE_NAME } from "../../site.config";
const allTalks = await Astro.glob("../../content/talks/*.md");
import HomePageLayout from "../../layouts/HomePageLayout.astro";
import TalkCard from "../../components/talk/TalkCard";
---

<HomePageLayout url="Talks" title={SITE_NAME}>
  <div class="listing-page">
    <div class="section-heading">
      <p class="section-kicker">Talks / Notes</p>
      <h1>Ideas worth sharing</h1>
    </div>
    <div class="listing-grid">
      {
        allTalks.map((talk, index) => (
          <TalkCard
            index={index}
            image={talk.frontmatter.image}
            title={talk.frontmatter.title}
            blogUrl={talk.frontmatter.blogUrl}
            videoUrl={talk.frontmatter.videoUrl}
            postUrl={talk.frontmatter.postUrl}
            pptUrl={talk.frontmatter.pptUrl}
          />
        ))
      }
    </div>
  </div>
</HomePageLayout>
