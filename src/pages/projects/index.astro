---
import { SITE_NAME } from "../../site.config";
const allProjects = await Astro.glob("../../content/projects/*.md");
const excludedProjectTitles = new Set(["under the hood", "snooby", "gamex"]);
const visibleProjects = allProjects.filter(
  (project) =>
    !excludedProjectTitles.has(project.frontmatter.title.trim().toLowerCase()),
);
import HomePageLayout from "../../layouts/HomePageLayout.astro";
import ProjectCard from "../../components/project/ProjectCard";
---

<HomePageLayout url="Projects" title={SITE_NAME}>
  <div class="listing-page">
    <div class="section-heading">
      <p class="section-kicker">Projects / 2024—present</p>
      <h1>Things I have made</h1>
    </div>
    <div class="listing-grid">
      {
        visibleProjects.map((project, index) => (
          <ProjectCard
            index={index}
            title={project.frontmatter.title}
            description={project.frontmatter.description}
            image={project.frontmatter.image}
            codebaseUrl={project.frontmatter.codebaseUrl}
            projectUrl={project.frontmatter.projectUrl}
            videoUrl={project.frontmatter.videoUrl}
            status={project.frontmatter.status}
          />
        ))
      }
    </div>
  </div>
</HomePageLayout>
