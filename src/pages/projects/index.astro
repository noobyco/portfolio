---
const allProjects = await Astro.glob("../../content/projects/*.md")
import HomePageLayout from "../../layouts/HomePageLayout.astro"
import ProjectCard from "../../components/project/ProjectCard"
import "../../styles/global.css"
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />    
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>shekh md moinuddin</title>
	</head>
	<body>
        <HomePageLayout url="Projects">
			<div class="listing-page">
				<div class="section-heading"><p class="section-kicker">Projects / 2024—present</p><h1>Things I have made</h1></div>
				<div class="listing-grid">
                {
                    allProjects.map((project) => (
                            <ProjectCard title={project.frontmatter.title} description={project.frontmatter.description} image={project.frontmatter.image} codebaseUrl={project.frontmatter.codebaseUrl} projectUrl={project.frontmatter.projectUrl} videoUrl={project.frontmatter.videoUrl} status={project.frontmatter.status} client:load />
                    ))
                }
				</div>
            </div>
        </HomePageLayout>
	</body>
</html>